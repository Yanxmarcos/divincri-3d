		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/SISTEMA_DIVINCRI" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option working_dir="." />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-lglu32" />
					<Add option="-lopengl32" />
					<Add library="libwxmsw33u.a" />
					<Add library="libwxmsw33u_gl.a" />
					<Add library="libopengl32.a" />
					<Add library="libglu32.a" />
					<Add library="libgdi32.a" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/SISTEMA_DIVINCRI" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option working_dir="." />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add library="libwxmsw33u.a" />
					<Add library="libwxmsw33u_gl.a" />
					<Add option="-lglu32" />
					<Add option="-lopengl32" />
					<Add option="-lgdi32" />
					<Add directory="$(#wx)/lib/gcc_dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
